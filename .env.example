# Web
NEXT_PUBLIC_APP_NAME=Open RAG Chat
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Supabase. Never expose the service role key to the browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# LiteLLM is the only gateway used by ordinary chat/compression calls.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=local-dev-key
CHAT_MODEL=chat-default
CONTEXT_COMPRESSION_MODEL=context-compressor
ALLOW_MOCK_LLM=true
REQUIRE_AUTH=false

# Google native search is isolated because it cannot share one model request
# with ordinary LangChain function tools.
GOOGLE_API_KEY=
GOOGLE_SEARCH_MODEL=gemini-3.6-flash

# Firecrawl v2 works with both cloud and a compatible self-hosted endpoint.
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_API_KEY=

# Embedding and reranking services.
TEI_EMBEDDING_URL=http://127.0.0.1:8081
TEI_RERANKER_URL=http://127.0.0.1:8082
EMBEDDING_DIMENSIONS=1024
RETRIEVAL_CANDIDATE_LIMIT=40
RETRIEVAL_RERANK_LIMIT=12

# Context policy. Percentages are model-window watermarks.
CONTEXT_SOFT_LIMIT=0.65
CONTEXT_HARD_LIMIT=0.80
CONTEXT_EMERGENCY_LIMIT=0.92
CONTEXT_RECENT_MESSAGES=12
CONTEXT_MODEL_WINDOW_TOKENS=1048576

# Observability
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
OTEL_SERVICE_NAME=open-rag-chat
EVALUATION_WORKER_TOKEN=
EVALUATION_API_URL=http://127.0.0.1:3000/api/internal/evaluate
